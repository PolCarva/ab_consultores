RESEND_API_KEY=your-resend-api-key


# Neon Postgres (pooled en Vercel). uselibpqcompat evita warnings de pg con sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&uselibpqcompat=true"

# openssl rand -base64 32
AUTH_SECRET="genera-un-secreto-largo-aqui"

# Primer administrador (solo para npm run db:seed)
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_PASSWORD="cambiar-por-una-contraseña-segura"
ADMIN_NAME="Administrador"

# Vercel Blob (producción — imágenes de portada)
BLOB_READ_WRITE_TOKEN=""
